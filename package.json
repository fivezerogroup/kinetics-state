{
	"name": "@fivezerogroup/kinetics-state",
	"version": "1.0.0",
	"description": "The missing reactive state foundation for Inertia.js",
	"main": "./dist/index.js",
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"keywords": [
		"inertia",
		"state",
		"react",
		"url",
		"indexeddb",
		"debounce"
	],
	"author": "",
	"license": "MIT",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"commit": "cz"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/@ryansonshine/cz-conventional-changelog"
		}
	},
	"dependencies": {
		"idb-keyval": "^6.2.1"
	},
	"peerDependencies": {
		"@inertiajs/core": "^2.0.0 || ^3.0.0",
		"@inertiajs/react": "^2.0.0 || ^3.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"packageManager": "pnpm@10.22.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@ryansonshine/commitizen": "^4.2.8",
		"@ryansonshine/cz-conventional-changelog": "^3.3.4",
		"@types/react": "^19.2.17",
		"@vitest/coverage-v8": "^3.0.0",
		"happy-dom": "^17.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.7.3",
		"vitest": "^3.0.0"
	}
}
